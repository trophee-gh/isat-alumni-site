<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root { --bleu: #0b3d6e; --fond: #f6f7f9; --texte: #1b1f24; }
  * { box-sizing: border-box; }
  body { font-family: system-ui, sans-serif; margin: 0; line-height: 1.55; color: var(--texte); background: #fff; }
  header, main, footer { max-width: 48rem; margin: 0 auto; padding: 1rem; }
  header { border-bottom: 3px solid var(--bleu); }
  .marque { display: inline-block; padding: .6rem 0; font-weight: 700; color: var(--bleu); text-decoration: none; font-size: 1.1rem; }
  nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: .25rem 1rem; padding: 0; margin: .5rem 0 0; }
  nav a { display: inline-block; padding: .6rem 0; color: var(--bleu); }
  .cible { display: inline-block; padding: .6rem 0; }
  nav a[aria-current] { font-weight: 700; text-decoration: none; }
  h1 { color: var(--bleu); line-height: 1.2; }
  footer { background: var(--fond); border-radius: .5rem; margin-bottom: 1rem; }
  .boutons { display: flex; flex-direction: column; gap: .5rem; }
  .bouton { display: block; padding: .75rem 1rem; border-radius: .4rem; background: var(--bleu); color: #fff; text-decoration: none; text-align: center; min-height: 44px; }
  .bouton.a-venir { background: #d5d9de; color: #444; }
  select { font-size: 1rem; min-height: 44px; width: 100%; margin-bottom: .5rem; }
  label { display: block; }
  #liste li { padding: .5rem 0; }
  #liste a { display: inline-block; min-height: 44px; padding-top: .6rem; }
  @media (min-width: 40rem) { .boutons { flex-direction: row; } .bouton { flex: 1; } label { display: inline-block; width: 48%; } }
</style>
</head>
<body>
<header>
  <a class="marque" href="/">{{ site.nom }}</a>
  <nav aria-label="Principale"><ul>
    <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Accueil</a></li>
    <li><a href="/qui-sommes-nous/"{% if page.url == "/qui-sommes-nous/" %} aria-current="page"{% endif %}>Qui sommes-nous</a></li>
    <li><a href="/annuaire/"{% if page.url == "/annuaire/" %} aria-current="page"{% endif %}>Annuaire</a></li>
    <li>{% if site.liens.linkedin.startsWith("TBD") %}<span data-tbd="{{ site.liens.linkedin }}">Actualités (LinkedIn, bientôt)</span>{% else %}<a href="{{ site.liens.linkedin }}" rel="noopener">Actualités sur LinkedIn ↗</a>{% endif %}</li>
  </ul></nav>
</header>
<main>
{{ content | safe }}
</main>
<footer>
  <div class="boutons">
    {% set url = site.liens.helloasso %}{% set texte = "Adhérer ou faire un don" %}{% include "lien.njk" %}
    {% set url = site.liens.brevo %}{% set texte = "Recevoir les nouvelles" %}{% include "lien.njk" %}
    {% set url = site.liens.emploi %}{% set texte = "Proposer une offre d'emploi" %}{% include "lien.njk" %}
  </div>
</footer>
</body>
</html>
