<!doctype html>
<html lang="{{ lang or 'fr' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{%- if description %}
<meta name="description" content="{{ description }}">{% endif %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/site.css">
</head>
<body>
<a class="skip" href="#main">{% if lang == "en" %}Skip to content{% else %}Aller au contenu{% endif %}</a>
{% include "components/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "components/prev-next.njk" %}
{% include "components/footer.njk" %}
{% include "components/floating-buttons.njk" %}
<script src="/assets/site.js"></script>
</body>
</html>
