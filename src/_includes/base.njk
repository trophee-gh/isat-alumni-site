<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  /* Fonts: served from the site (FE3), Latin subsets, SIL OFL (licence beside each file in src/fonts). */
  @font-face { font-family: "Charis SIL"; src: url("/fonts/charissil/CharisSIL-Regular.woff2") format("woff2"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Charis SIL"; src: url("/fonts/charissil/CharisSIL-Bold.woff2") format("woff2"); font-weight: 700; font-display: swap; }
  @font-face { font-family: "Archivo"; src: url("/fonts/archivo/Archivo.woff2") format("woff2"); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: "Archivo"; src: url("/fonts/archivo/Archivo-Italic.woff2") format("woff2"); font-weight: 100 900; font-style: italic; font-display: swap; }
  @font-face { font-family: "Archivo Narrow"; src: url("/fonts/archivonarrow/ArchivoNarrow.woff2") format("woff2"); font-weight: 400 700; font-display: swap; }

  /* The ISAT chart's colours (Octobre 2025) and typefaces (Charter for titles, Arial Narrow for labels). */
  :root {
    --bordeaux: #a10e2f; --bordeaux-fonce: #600815; --bordeaux-clair: #e4c8cb;
    --gris: #303b3e; --gris-web: #65696b; --blanc: #ffffff;
    --filet: rgba(161, 14, 47, .18);
    --police-titre: "Charis SIL", Charter, "Bitstream Charter", Georgia, serif;
    --police-texte: "Archivo", Arial, sans-serif;
    --police-etroite: "Archivo Narrow", "Arial Narrow", Arial, sans-serif;
  }

  * { box-sizing: border-box; }
  body { display: flex; flex-direction: column; min-height: 100vh; margin: 0; font-family: var(--police-texte); font-size: 1rem; line-height: 1.625; color: var(--gris); background: var(--blanc); }
  .cadre { max-width: 52rem; margin: 0 auto; padding: 0 1rem; }
  a { color: var(--bordeaux); text-underline-offset: .18em; text-decoration-thickness: 1px; }
  a:hover { text-decoration-thickness: 2px; }

  /* Header: the burgundy band. */
  .bandeau { background: var(--bordeaux); color: var(--blanc); padding: 1.25rem 0 1rem; border-bottom: 4px solid var(--bordeaux-fonce); }
  .bandeau .cadre { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: .75rem 2rem; }
  .marque { display: inline-block; color: inherit; text-decoration: none; line-height: 1.05; padding: .25rem 0; }
  .marque-haut { display: block; font-family: var(--police-etroite); text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; font-weight: 600; }
  .marque-nom { display: block; font-family: var(--police-titre); font-weight: 700; font-size: 2.25rem; letter-spacing: .01em; }
  nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0 1.25rem; padding: 0; margin: 0; }
  nav a, nav span { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--police-etroite);
    text-transform: uppercase; letter-spacing: .06em; font-size: .9rem; font-weight: 600; color: inherit; text-decoration: none; border-bottom: 2px solid transparent; }
  nav a:hover, nav a[aria-current] { border-bottom-color: currentColor; }
  nav span { color: var(--bordeaux-clair); font-weight: 400; }

  /* Content. */
  main.cadre { flex: 1; width: 100%; padding-top: 2.5rem; padding-bottom: 3rem; }
  h1, h2 { font-family: var(--police-titre); font-weight: 700; color: var(--bordeaux); line-height: 1.2; }
  h1 { font-size: 2.1rem; margin: 0 0 1.25rem; }
  h1::after { content: ""; display: block; width: 3rem; height: 4px; margin-top: .75rem; background: var(--bordeaux); }
  h1 + p { font-size: 1.125rem; }
  h2 { font-size: 1.45rem; margin: 2rem 0 .5rem; }
  main p, main li { max-width: 40rem; }
  main ul { padding-left: 1.25rem; }
  main ul:not(#liste) li + li { margin-top: .75rem; }
  main li::marker { color: var(--bordeaux); }
  .cible { display: inline-block; padding: .6rem 0; margin: -.6rem 0; font-weight: 600; }

  /* Annuaire. */
  #filtres { display: flex; flex-wrap: wrap; gap: .75rem 1rem; margin: 1.5rem 0 .5rem; }
  label { flex: 1 1 14rem; display: block; font-family: var(--police-etroite); text-transform: uppercase; letter-spacing: .06em; font-size: .85rem; font-weight: 600; }
  select { display: block; width: 100%; min-height: 44px; margin-top: .25rem; padding: 0 .75rem; font-family: var(--police-texte); text-transform: none; letter-spacing: 0; font-size: 1rem; font-weight: 400;
    color: var(--gris); background: var(--blanc); border: 1px solid var(--gris-web); border-radius: 2px; }
  select:disabled { opacity: .6; }
  #etat { font-style: italic; }
  #liste { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--filet); }
  #liste li { padding: .25rem 0; border-bottom: 1px solid var(--filet); max-width: none; }
  #liste a { display: inline-block; min-height: 44px; padding-top: .6rem; font-weight: 600; }

  /* Footer: the three buttons. */
  .pied { background: var(--gris); color: var(--blanc); padding: 2rem 0 2.5rem; }
  .boutons { display: flex; flex-direction: column; gap: .75rem; }
  .bouton { display: flex; align-items: center; justify-content: center; gap: .4rem; flex-wrap: wrap; min-height: 48px; padding: .7rem 1rem; border-radius: 2px;
    background: var(--blanc); color: var(--bordeaux); text-decoration: none; text-align: center; font-weight: 600; }
  .bouton.a-venir { background: transparent; color: var(--blanc); border: 1px solid var(--gris-web); font-weight: 400; }
  .bouton small { font-size: .85em; font-style: italic; }
  @media (min-width: 40rem) { .boutons { flex-direction: row; } .bouton { flex: 1; } }
</style>
</head>
<body>
<header class="bandeau">
  <div class="cadre">
  <a class="marque" href="/">{{ site.nom | replace("Association des ingénieurs de ", '<span class="marque-haut">Association des ingénieurs de</span> ') | replace("l'ISAT", '<span class="marque-nom">l&#39;ISAT</span>') | safe }}</a>
  <nav aria-label="Principale"><ul>
    <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Accueil</a></li>
    <li><a href="/qui-sommes-nous/"{% if page.url == "/qui-sommes-nous/" %} aria-current="page"{% endif %}>Qui sommes-nous</a></li>
    <li><a href="/annuaire/"{% if page.url == "/annuaire/" %} aria-current="page"{% endif %}>Annuaire</a></li>
    <li>{% if site.liens.linkedin.startsWith("TBD") %}<span data-tbd="{{ site.liens.linkedin }}">Actualités (LinkedIn, bientôt)</span>{% else %}<a href="{{ site.liens.linkedin }}" rel="noopener">Actualités sur LinkedIn ↗</a>{% endif %}</li>
  </ul></nav>
  </div>
</header>
<main class="cadre">
{{ content | safe }}
</main>
<footer class="pied">
  <div class="cadre boutons">
    {% set url = site.liens.helloasso %}{% set texte = "Adhérer ou faire un don" %}{% include "lien.njk" %}
    {% set url = site.liens.brevo %}{% set texte = "Recevoir les nouvelles" %}{% include "lien.njk" %}
    {% set url = site.liens.emploi %}{% set texte = "Proposer une offre d'emploi" %}{% include "lien.njk" %}
  </div>
</footer>
</body>
</html>
