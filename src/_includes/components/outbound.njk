{#- LinkedIn and HelloAsso as outbound cards (links only, nothing embedded: FE3). URLs TBD, so href="#".
    Var: outLang ("fr" default | "en"). -#}
{%- if outLang == "en" -%}
{%- set cards = [
  {kind: "LinkedIn · daily feed", lead: "School news, relayed offers and the network's life, day to day.", go: "Follow the association", dom: "linkedin.com/…"},
  {kind: "HelloAsso · annual membership", lead: "Membership funds student meetings and the annuaire. Payment handled by HelloAsso; amount <span class='tbd'>TBD</span>", go: "Join", dom: "helloasso.com/…"}
] -%}
{%- else -%}
{%- set cards = [
  {kind: "LinkedIn · le fil quotidien", lead: "Les nouvelles de l'école, les offres relayées et la vie du réseau, au jour le jour.", go: "Suivre l'association", dom: "linkedin.com/…"},
  {kind: "HelloAsso · adhésion annuelle", lead: "Adhérer soutient les rencontres avec les étudiants et l'annuaire. Paiement par HelloAsso ; montant <span class='tbd'>TBD</span>", go: "Adhérer", dom: "helloasso.com/…"}
] -%}
{%- endif %}
<div class="grid-2">
{%- for c in cards %}<a class="card out" href="#" rel="noopener"><div class="eyebrow">{{ c.kind }}</div><div class="glyph">{% include "icons/arrow.njk" %}</div><p class="lead m0">{{ c.lead | safe }}</p><div class="go">{{ c.go }} {% include "icons/arrow.njk" %}</div><div class="dom">{{ c.dom }} <span class="tbd">URL TBD</span></div></a>{% endfor %}
</div>
